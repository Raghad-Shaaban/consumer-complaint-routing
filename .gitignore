
# Ignore generated datasets
/data/raw/*
!/data/raw/.gitkeep

/data/interim/*
!/data/interim/.gitkeep

# Keep inventory tracked
!/data/inventory.csv

# Ignore model artifacts
/models/*
!/models/.gitkeep

# Python artifacts
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# Local environments
.venv/
venv/
env/

# Secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
